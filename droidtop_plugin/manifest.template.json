{
  "id": "gamegrab.f95",
  "origin": "gamegrab",
  "label": "F95zone",
  "description": "Finds F95zone games, checks your linked games for new versions, and downloads them with your F95zone account.",
  "version": "0.8.7",
  "kind": "flutter_embed",
  "contractVersion": 3,
  "subscribedEvents": [
    "web.session.signed_in",
    "context.received"
  ],
  "category": "sources",
  "requestsRoot": false,
  "settings": [
    {
      "id": "sync",
      "kind": "action",
      "label": "Sync the watch list now",
      "op": "syncWatched",
      "when": "web.session.signed_in"
    },
    {
      "id": "watched",
      "kind": "info",
      "label": "Watch list",
      "sub": "Syncs with F95zone once you sign in on droidtop's F95zone account row, on this plugin's page.",
      "when": "not web.session.signed_in"
    }
  ],
  "provides": [
    {
      "point": "library.updates",
      "version": 1,
      "id": "f95zone",
      "label": "F95zone thread",
      "linkHint": "Thread link or number; blank unlinks"
    },
    {
      "point": "library.sources",
      "version": 1,
      "id": "f95zone",
      "label": "F95zone",
      "systems": ["windows", "linux"]
    },
    {
      "point": "library.metadata",
      "version": 1,
      "id": "f95zone",
      "label": "F95zone"
    },
    {
      "point": "ui.facets",
      "version": 1,
      "id": "main",
      "targets": ["settings.page"]
    },
    {
      "point": "computers.context_adapter",
      "version": 1,
      "id": "f95checker",
      "label": "F95Checker",
      "programs": {
        "windows-x86_64": {
          "url": "https://github.com/gamegrab-sources/droidtop-agent-f95-adapter/releases/download/build-8/droidtop-agent-f95-adapter-windows-x86_64.exe",
          "sha256": "947d17007b65f4ccaa506d7c0e3ec455171659a78eea0847456b4f494815f6e0"
        },
        "linux-x86_64": {
          "url": "https://github.com/gamegrab-sources/droidtop-agent-f95-adapter/releases/download/build-8/droidtop-agent-f95-adapter-linux-x86_64",
          "sha256": "f812c45ae5b98bfde53202e106d754a437e650e1d8166b1f75b96947940b50c2"
        },
        "macos-aarch64": {
          "url": "https://github.com/gamegrab-sources/droidtop-agent-f95-adapter/releases/download/build-8/droidtop-agent-f95-adapter-macos-arm64",
          "sha256": "e99be48b255bae5b31ab6d22886f6aaebda8b347d021bbe2769e2c7d05ba07a9"
        }
      }
    }
  ],
  "permissions": [
    {
      "id": "net.domains",
      "domains": [
        "f95zone.to",
        "attachments.f95zone.to",
        "api.f95checker.dev"
      ],
      "reason": "Searches F95zone, asks F95Checker's public index for thread versions and details, and names a thread's banner for droidtop to fetch as the game's cover"
    },
    {
      "id": "web.session",
      "domains": [
        "f95zone.to"
      ],
      "signIn": "https://f95zone.to/login/",
      "doneCookie": "xf_user",
      "expiredText": [
        "link has expired"
      ],
      "reason": "Lets you sign in to F95zone in droidtop's browser view, to see download links and sync your watch list"
    },
    {
      "id": "notify.post",
      "reason": "Tells you when a game you linked has a new version"
    },
    {
      "id": "library.folders.write",
      "reason": "Games you choose to download are placed in your game folder"
    },
    {
      "id": "context.sync",
      "reason": "Keeps your watched threads, and the versions you installed and finished, the same as F95Checker's on your paired computers"
    }
  ],
  "abis": [
    "arm64-v8a",
    "x86_64"
  ]
}
