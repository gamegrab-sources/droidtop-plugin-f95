  "permissions": [
    {
      "id": "net.domains",
      "domains": [
        "f95zone.to",
        "attachments.f95zone.to",
        "api.f95checker.dev"
      ],
      "reason": "Searches F95zone, asks F95Checker's public index for thread versions and details, and names a thread's banner for droidtop to fetch as the game's cover"
    },
    {
      "id": "web.session",
      "domains": [
        "f95zone.to"
      ],
      "signIn": "https://f95zone.to/login/",
      "doneCookie": "xf_user",
      "expiredText": [
        "link has expired"
      ],
      "reason": "Lets you sign in to F95zone in droidtop's browser view, to see download links and sync your watch list"
    },
    {
      "id": "notify.post",
      "reason": "Tells you when a game you linked has a new version"
    },
    {
      "id": "library.folders.write",
      "reason": "Games you choose to download are placed in your game folder"
    },
    {
      "id": "context.sync",
      "reason": "Keeps your watched threads, and the versions you installed and finished, the same as F95Checker's on your paired computers"
